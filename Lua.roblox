-- [[ Dark & Terrifying UI Framework - Created for Scripting ]]
-- Features: Animated Gradient, Water Drop Ripple, Single-Finger Lock Dragging, 9K Image Frame with Gloss, Copyright System, Dual Columns, and Bottom-Right Notifications.

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local UI_Library = {}

function UI_Library:CreateWindow(config)
	config = config or {}
	local Title = config.Title or "TERROR HUB"
	local Subtitle = config.Subtitle or "Advanced Script Environment"
	local Size = config.Size or UDim2.new(0, 580, 0, 420)
	local CopyrightText = config.Copyright or "By: Abdullah"
	local CopyrightColor = config.CopyrightColor or Color3.fromRGB(255, 50, 50)
	local CustomImageId = config.ImageId or "" -- رابط أو ID صورة الإطار (9k/Image Frame)
	local OpenButtonEnabled = config.OpenButton ~= false

	-- Root ScreenGui
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "TerrifyingUI_Framework"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	
	-- حماية الـ GUI وحفظها في CoreGui إن أمكن
	pcall(function()
		ScreenGui.Parent = CoreGui
	end)
	if ScreenGui.Parent == nil then
		ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	end

	-- Main Window Frame
	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Size = Size
	MainFrame.Position = UDim2.new(0.5, -Size.X.Offset/2, 0.5, -Size.Y.Offset/2)
	MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
	MainFrame.BorderSizePixel = 0
	MainFrame.Active = true
	MainFrame.Draggable = false -- سنقوم بعمل نظام السحب الخاص الموزون بـ Single-Finger
	MainFrame.Parent = ScreenGui

	-- زوايا دائرية فخمة
	local UICorner = Instance.new("UICorner")
	UICorner.CornerRadius = UDim.new(0, 10)
	UICorner.Parent = MainFrame

	-- إطار الصورة الخلفي (9k Image Frame with Gloss & Shine)
	if CustomImageId ~= "" then
		local ImageFrame = Instance.new("ImageLabel")
		ImageFrame.Name = "CustomImageFrame"
		ImageFrame.Size = UDim2.new(1, 0, 1, 0)
		ImageFrame.BackgroundTransparency = 1
		ImageFrame.Image = CustomImageId
		ImageFrame.ScaleType = Enum.ScaleType.Slice
		ImageFrame.SliceCenter = Rect.new(100, 100, 100, 100)
		ImageFrame.ImageTransparency = 0.35
		ImageFrame.ZIndex = 2
		ImageFrame.Parent = MainFrame

		-- طبقة لمعان احترافية فوق الصورة
		local GlossOverlay = Instance.new("Frame")
		GlossOverlay.Size = UDim2.new(1, 0, 1, 0)
		GlossOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		GlossOverlay.BackgroundTransparency = 0.92
		GlossOverlay.BorderSizePixel = 0
		GlossOverlay.ZIndex = 3
		GlossOverlay.Parent = MainFrame
		local GlossCorner = Instance.new("UICorner")
		GlossCorner.CornerRadius = UDim.new(0, 10)
		GlossCorner.Parent = GlossOverlay
	end

	-- إطار تدرج متحرك للأطراف (Animated Gradient Border)
	local Stroke = Instance.new("UIStroke")
	Stroke.Thickness = 2
	Stroke.Color = Color3.fromRGB(180, 0, 0)
	Stroke.Parent = MainFrame

	local Gradient = Instance.new("UIGradient")
	Gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 0, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
	})
	Gradient.Parent = Stroke

	-- أنميشن تدرج الألوان المتحرك
	task.spawn(function()
		while ScreenGui.Parent do
			Gradient.Rotation = (Gradient.Rotation + 2) % 360
			task.wait(0.03)
		end
	end)

	-- نظام السحب الموزون (الثقيل) مع قفل الإصبع الأول (Single-Finger Lock Dragging)
	local dragging = false
	local dragInput, dragStart, startPos
	local activeTouchId = nil

	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if not dragging then
				dragging = true
				dragStart = input.Position
				startPos = MainFrame.Position
				if input.UserInputType == Enum.UserInputType.Touch then
					activeTouchId = input
				end
				
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						if input == activeTouchId or input.UserInputType == Enum.UserInputType.MouseButton1 then
							dragging = false
							activeTouchId = nil
						end
					end
				end)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging then
			if input.UserInputType == Enum.UserInputType.MouseMovement or (input.UserInputType == Enum.UserInputType.Touch and input == activeTouchId) then
				local delta = input.Position - dragStart
				MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)

	-- أنميشن قطرة الماء (Ripple Effect) عند الضغط في أي مكان داخل النافذة
	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local mousePos = input.Position
			local absPos = MainFrame.AbsolutePosition
			local relX = mousePos.X - absPos.X
			local relY = mousePos.Y - absPos.Y

			local ripple = Instance.new("Frame")
			ripple.Size = UDim2.new(0, 0, 0, 0)
			ripple.Position = UDim2.new(0, relX, 0, relY)
			ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			ripple.BackgroundTransparency = 0.6
			ripple.BorderSizePixel = 0
			ripple.ZIndex = 10
			ripple.Parent = MainFrame

			local rCorner = Instance.new("UICorner")
			rCorner.CornerRadius = UDim.new(1, 0)
			rCorner.Parent = ripple

			local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tween = TweenService:Create(ripple, tweenInfo, {
				Size = UDim2.new(0, 300, 0, 300),
				Position = UDim2.new(0, relX - 150, 0, relY - 150),
				BackgroundTransparency = 1
			})
			tween:Play()
			tween.Completed:Connect(function()
				ripple:Destroy()
			end)
		end
	end)

	-- Top Bar / Header
	local TopBar = Instance.new("Frame")
	TopBar.Size = UDim2.new(1, 0, 0, 50)
	TopBar.BackgroundTransparency = 1
	TopBar.ZIndex = 4
	TopBar.Parent = MainFrame

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(0, 300, 0, 25)
	TitleLabel.Position = UDim2.new(0, 15, 0, 5)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.Text = Title
	TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	TitleLabel.TextSize = 16
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.ZIndex = 4
	TitleLabel.Parent = TopBar

	local SubTitleLabel = Instance.new("TextLabel")
	SubTitleLabel.Size = UDim2.new(0, 300, 0, 18)
	SubTitleLabel.Position = UDim2.new(0, 15, 0, 26)
	SubTitleLabel.BackgroundTransparency = 1
	SubTitleLabel.Font = Enum.Font.Gotham
	SubTitleLabel.Text = Subtitle
	SubTitleLabel.TextColor3 = Color3.fromRGB(140, 140, 150)
	SubTitleLabel.TextSize = 11
	SubTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	SubTitleLabel.ZIndex = 4
	SubTitleLabel.Parent = TopBar

	-- نظام الحقوق (Copyright System أعلى يمين النافذة بجوار العنوان)
	local CopyrightLabel = Instance.new("TextLabel")
	CopyrightLabel.Size = UDim2.new(0, 150, 0, 30)
	CopyrightLabel.Position = UDim2.new(1, -165, 0, 10)
	CopyrightLabel.BackgroundTransparency = 1
	CopyrightLabel.Font = Enum.Font.GothamBold
	CopyrightLabel.Text = CopyrightText
	CopyrightLabel.TextColor3 = CopyrightColor
	CopyrightLabel.TextSize = 12
	CopyrightLabel.TextXAlignment = Enum.TextXAlignment.Right
	CopyrightLabel.ZIndex = 4
	CopyrightLabel.Parent = TopBar

	-- خط فاصل تحت الـ TopBar
	local Divider = Instance.new("Frame")
	Divider.Size = UDim2.new(1, -20, 0, 1)
	Divider.Position = UDim2.new(0, 10, 0, 50)
	Divider.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	Divider.BorderSizePixel = 0
	Divider.ZIndex = 4
	Divider.Parent = MainFrame

	-- نظام التبويبات (Center-Left Tabs Container)
	local TabContainer = Instance.new("ScrollingFrame")
	TabContainer.Size = UDim2.new(0, 140, 1, -65)
	TabContainer.Position = UDim2.new(0, 10, 0, 58)
	TabContainer.BackgroundTransparency = 1
	TabContainer.BorderSizePixel = 0
	TabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
	TabContainer.ScrollBarThickness = 2
	TabContainer.ZIndex = 4
	TabContainer.Parent = MainFrame

	local TabListLayout = Instance.new("UIListLayout")
	TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	TabListLayout.Padding = UDim.new(0, 6)
	TabListLayout.Parent = TabContainer

	-- حاوية محتوى التبويبات (Pages Area)
	local PagesContainer = Instance.new("Frame")
	PagesContainer.Size = UDim2.new(1, -165, 1, -65)
	PagesContainer.Position = UDim2.new(0, 155, 0, 58)
	PagesContainer.BackgroundTransparency = 1
	PagesContainer.ZIndex = 4
	PagesContainer.Parent = MainFrame

	local FirstTab = true
	local TabsAPI = {}

	function TabsAPI:CreateTab(tabName)
		local TabButton = Instance.new("TextButton")
		TabButton.Size = UDim2.new(1, 0, 0, 34)
		TabButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
		TabButton.BorderSizePixel = 0
		TabButton.AutoButtonColor = false
		TabButton.Font = Enum.Font.GothamMedium
		TabButton.Text = tabName
		TabButton.TextColor3 = Color3.fromRGB(160, 160, 170)
		TabButton.TextSize = 13
		TabButton.ZIndex = 4
		TabButton.Parent = TabContainer

		local BtnCorner = Instance.new("UICorner")
		BtnCorner.CornerRadius = UDim.new(0, 6)
		BtnCorner.Parent = TabButton

		-- Page Content Area with Sections/Columns System (Dual Column Left & Right)
		local TabPage = Instance.new("ScrollingFrame")
		TabPage.Size = UDim2.new(1, 0, 1, 0)
		TabPage.BackgroundTransparency = 1
		TabPage.BorderSizePixel = 0
		TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
		TabPage.ScrollBarThickness = 3
		TabPage.Visible = false
		TabPage.ZIndex = 4
		TabPage.Parent = PagesContainer

		local LeftColumn = Instance.new("ScrollingFrame")
		LeftColumn.Name = "LeftColumn"
		LeftColumn.Size = UDim2.new(0.5, -5, 1, 0)
		LeftColumn.BackgroundTransparency = 1
		LeftColumn.BorderSizePixel = 0
		LeftColumn.CanvasSize = UDim2.new(0, 0, 0, 0)
		LeftColumn.ScrollBarThickness = 0
		LeftColumn.ZIndex = 4
		LeftColumn.Parent = TabPage

		local LeftLayout = Instance.new("UIListLayout")
		LeftLayout.SortOrder = Enum.SortOrder.LayoutOrder
		LeftLayout.Padding = UDim.new(0, 8)
		LeftLayout.Parent = LeftColumn

		local RightColumn = Instance.new("ScrollingFrame")
		RightColumn.Name = "RightColumn"
		RightColumn.Size = UDim2.new(0.5, -5, 1, 0)
		RightColumn.Position = UDim2.new(0.5, 5, 0, 0)
		RightColumn.BackgroundTransparency = 1
		RightColumn.BorderSizePixel = 0
		RightColumn.CanvasSize = UDim2.new(0, 0, 0, 0)
		RightColumn.ScrollBarThickness = 0
		RightColumn.ZIndex = 4
		RightColumn.Parent = TabPage

		local RightLayout = Instance.new("UIListLayout")
		RightLayout.SortOrder = Enum.SortOrder.LayoutOrder
		RightLayout.Padding = UDim.new(0, 8)
		RightLayout.Parent = RightColumn

		-- تحديث حجم الـ Canvas تلقائياً
		LeftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			LeftColumn.CanvasSize = UDim2.new(0, 0, 0, LeftLayout.AbsoluteContentSize.Y + 10)
			TabPage.CanvasSize = UDim2.new(0, 0, 0, math.max(LeftLayout.AbsoluteContentSize.Y, RightLayout.AbsoluteContentSize.Y) + 10)
		end)
		RightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			RightColumn.CanvasSize = UDim2.new(0, 0, 0, RightLayout.AbsoluteContentSize.Y + 10)
			TabPage.CanvasSize = UDim2.new(0, 0, 0, math.max(LeftLayout.AbsoluteContentSize.Y, RightLayout.AbsoluteContentSize.Y) + 10)
		end)

		if FirstTab then
			FirstTab = false
			TabPage.Visible = true
			TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			TabButton.BackgroundColor3 = Color3.fromRGB(35, 15, 20)
		end

		TabButton.MouseButton1Click:Connect(function()
			for _, child in pairs(PagesContainer:GetChildren()) do
				if child:IsA("ScrollingFrame") then child.Visible = false end
			end
			for _, child in pairs(TabContainer:GetChildren()) do
				if child:IsA("TextButton") then
					child.TextColor3 = Color3.fromRGB(160, 160, 170)
					child.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
				end
			end
			TabPage.Visible = true
			TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			TabButton.BackgroundColor3 = Color3.fromRGB(35, 15, 20)
		end)

		local ElementsAPI = {}

		local function getColumn(side)
			if side:lower() == "right" then
				return RightColumn
			else
				return LeftColumn
			end
		end

		-- 1. زر تفاعلي (Button)
		function ElementsAPI:AddButton(btnConfig)
			btnConfig = btnConfig.Name and btnConfig or {Name = btnConfig, Side = "Left", Callback = function() end}
			local name = btnConfig.Name or "Button"
			local side = btnConfig.Side or "Left"
			local callback = btnConfig.Callback or function() end

			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, 0, 0, 35)
			Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			Btn.BorderSizePixel = 0
			Btn.AutoButtonColor = false
			Btn.Font = Enum.Font.GothamMedium
			Btn.Text = name
			Btn.TextColor3 = Color3.fromRGB(220, 220, 230)
			Btn.TextSize = 12
			Btn.ZIndex = 4
			Btn.Parent = getColumn(side)

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = Btn

			Btn.MouseButton1Click:Connect(function()
				task.spawn(callback)
				-- أنميشن نقرة خفيف
				TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(180, 0, 0)}):Play()
				task.wait(0.1)
				TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 26)}):Play()
			end)
		end

		-- 2. زر تبديل (Toggle Switch)
		function ElementsAPI:AddToggle(toggleConfig)
			local name = toggleConfig.Name or "Toggle"
			local default = toggleConfig.Default or false
			local side = toggleConfig.Side or "Left"
			local callback = toggleConfig.Callback or function() end

			local toggled = default

			local ToggleFrame = Instance.new("Frame")
			ToggleFrame.Size = UDim2.new(1, 0, 0, 35)
			ToggleFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			ToggleFrame.BorderSizePixel = 0
			ToggleFrame.ZIndex = 4
			ToggleFrame.Parent = getColumn(side)

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = ToggleFrame

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(1, -50, 1, 0)
			Label.Position = UDim2.new(0, 10, 0, 0)
			Label.BackgroundTransparency = 1
			Label.Font = Enum.Font.GothamMedium
			Label.Text = name
			Label.TextColor3 = Color3.fromRGB(220, 220, 230)
			Label.TextSize = 12
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = 4
			Label.Parent = ToggleFrame

			local SwitchBG = Instance.new("Frame")
			SwitchBG.Size = UDim2.new(0, 36, 0, 18)
			SwitchBG.Position = UDim2.new(1, -44, 0.5, -9)
			SwitchBG.BackgroundColor3 = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(40, 40, 50)
			SwitchBG.BorderSizePixel = 0
			SwitchBG.ZIndex = 4
			SwitchBG.Parent = ToggleFrame

			local SwitchCorner = Instance.new("UICorner")
			SwitchCorner.CornerRadius = UDim.new(1, 0)
			SwitchCorner.Parent = SwitchBG

			local Circle = Instance.new("Frame")
			Circle.Size = UDim2.new(0, 14, 0, 14)
			Circle.Position = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Circle.BorderSizePixel = 0
			Circle.ZIndex = 4
			Circle.Parent = SwitchBG

			local CircleCorner = Instance.new("UICorner")
			CircleCorner.CornerRadius = UDim.new(1, 0)
			CircleCorner.Parent = Circle

			ToggleFrame.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					toggled = not toggled
					local goalBGColor = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(40, 40, 50)
					local goalCirclePos = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)

					TweenService:Create(SwitchBG, TweenInfo.new(0.2), {BackgroundColor3 = goalBGColor}):Play()
					TweenService:Create(Circle, TweenInfo.new(0.2), {Position = goalCirclePos}):Play()

					task.spawn(function()
						callback(toggled)
					end)
				end
			end)
		end

		-- 3. خانة كتابة (Textbox / Input)
		function ElementsAPI:AddTextbox(inputConfig)
			local name = inputConfig.Name or "Input"
			local placeholder = inputConfig.Placeholder or "Type here..."
			local side = inputConfig.Side or "Left"
			local callback = inputConfig.Callback or function() end

			local InputFrame = Instance.new("Frame")
			InputFrame.Size = UDim2.new(1, 0, 0, 50)
			InputFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			InputFrame.BorderSizePixel = 0
			InputFrame.ZIndex = 4
			InputFrame.Parent = getColumn(side)

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = InputFrame

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(1, -16, 0, 20)
			Label.Position = UDim2.new(0, 10, 0, 4)
			Label.BackgroundTransparency = 1
			Label.Font = Enum.Font.GothamMedium
			Label.Text = name
			Label.TextColor3 = Color3.fromRGB(220, 220, 230)
			Label.TextSize = 12
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = 4
			Label.Parent = InputFrame

			local TextBox = Instance.new("TextBox")
			TextBox.Size = UDim2.new(1, -20, 0, 22)
			TextBox.Position = UDim2.new(0, 10, 0, 24)
			TextBox.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
			TextBox.BorderSizePixel = 0
			TextBox.Font = Enum.Font.Gotham
			TextBox.PlaceholderText = placeholder
			TextBox.Text = ""
			TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
			TextBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 110)
			TextBox.TextSize = 11
			TextBox.ZIndex = 4
			TextBox.Parent = InputFrame

			local tbCorner = Instance.new("UICorner")
			tbCorner.CornerRadius = UDim.new(0, 4)
			tbCorner.Parent = TextBox

			TextBox.FocusLost:Connect(function(enterPressed)
				task.spawn(function()
					callback(TextBox.Text, enterPressed)
				end)
			end)
		end

		-- 4. شريط التمرير الدقيق (Slider مع زر دائري Circular Thumb وسحب سلس فوري)
		function ElementsAPI:AddSlider(sliderConfig)
			local name = sliderConfig.Name or "Slider"
			local min = sliderConfig.Min or 0
			local max = sliderConfig.Max or 100
			local default = sliderConfig.Default or 50
			local side = sliderConfig.Side or "Left"
			local callback = sliderConfig.Callback or function() end

			local value = default

			local SliderFrame = Instance.new("Frame")
			SliderFrame.Size = UDim2.new(1, 0, 0, 50)
			SliderFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			SliderFrame.BorderSizePixel = 0
			SliderFrame.ZIndex = 4
			SliderFrame.Parent = getColumn(side)

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = SliderFrame

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(1, -60, 0, 20)
			Label.Position = UDim2.new(0, 10, 0, 5)
			Label.BackgroundTransparency = 1
			Label.Font = Enum.Font.GothamMedium
			Label.Text = name
			Label.TextColor3 = Color3.fromRGB(220, 220, 230)
			Label.TextSize = 12
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = 4
			Label.Parent = SliderFrame

			local ValueLabel = Instance.new("TextLabel")
			ValueLabel.Size = UDim2.new(0, 50, 0, 20)
			ValueLabel.Position = UDim2.new(1, -55, 0, 5)
			ValueLabel.BackgroundTransparency = 1
			ValueLabel.Font = Enum.Font.GothamBold
			ValueLabel.Text = tostring(value)
			ValueLabel.TextColor3 = Color3.fromRGB(200, 0, 0)
			ValueLabel.TextSize = 12
			ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
			ValueLabel.ZIndex = 4
			ValueLabel.Parent = SliderFrame

			local SliderBar = Instance.new("Frame")
			SliderBar.Size = UDim2.new(1, -20, 0, 6)
			SliderBar.Position = UDim2.new(0, 10, 0, 32)
			SliderBar.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
			SliderBar.BorderSizePixel = 0
			SliderBar.ZIndex = 4
			SliderBar.Parent = SliderFrame

			local sbCorner = Instance.new("UICorner")
			sbCorner.CornerRadius = UDim.new(1, 0)
			sbCorner.Parent = SliderBar

			local FillBar = Instance.new("Frame")
			FillBar.Size = UDim2.new((value - min)/(max - min), 0, 1, 0)
			FillBar.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
			FillBar.BorderSizePixel = 0
			FillBar.ZIndex = 4
			FillBar.Parent = SliderBar

			local fbCorner = Instance.new("UICorner")
			fbCorner.CornerRadius = UDim.new(1, 0)
			fbCorner.Parent = FillBar

			local Thumb = Instance.new("Frame")
			Thumb.Size = UDim2.new(0, 14, 0, 14)
			Thumb.Position = UDim2.new(1, -7, 0.5, -7)
			Thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Thumb.BorderSizePixel = 0
			Thumb.ZIndex = 5
			Thumb.Parent = FillBar

			local tCorner = Instance.new("UICorner")
			tCorner.CornerRadius = UDim.new(1, 0)
			tCorner.Parent = Thumb

			local draggingSlider = false

			local function updateSlider(input)
				local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
				value = math.floor(min + ((max - min) * pos))
				FillBar.Size = UDim2.new(pos, 0, 1, 0)
				ValueLabel.Text = tostring(value)
				task.spawn(function()
					callback(value)
				end)
			end

			SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSlider = true
					updateSlider(input)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlider(input)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSlider = false
				end
			end)
		end

		return ElementsAPI
	end

	-- 5. نظام الإشعارات الاحترافي (Bottom-Right Notifications)
	function UI_Library:Notify(notifConfig)
		local title = notifConfig.Title or "Notification"
		local message = notifConfig.Message or "Action completed successfully."
		local duration = notifConfig.Duration or 3.5

		local NotifContainer = ScreenGui:FindFirstChild("NotifContainer")
		if not NotifContainer then
			NotifContainer = Instance.new("Frame")
			NotifContainer.Name = "NotifContainer"
			NotifContainer.Size = UDim2.new(0, 250, 1, -20)
			NotifContainer.Position = UDim2.new(1, -260, 0, 10)
			NotifContainer.BackgroundTransparency = 1
			NotifContainer.ZIndex = 20
			NotifContainer.Parent = ScreenGui

			local nl = Instance.new("UIListLayout")
			nl.SortOrder = Enum.SortOrder.LayoutOrder
			nl.VerticalAlignment = Enum.VerticalAlignment.Bottom
			nl.Padding = UDim.new(0, 8)
			nl.Parent = NotifContainer
		end

		local NotifBox = Instance.new("Frame")
		NotifBox.Size = UDim2.new(1, 0, 0, 60)
		NotifBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
		NotifBox.BorderSizePixel = 0
		NotifBox.Position = UDim2.new(1, 50, 0, 0)
		NotifBox.ZIndex = 21
		NotifBox.Parent = NotifContainer

		local nc = Instance.new("UICorner")
		nc.CornerRadius = UDim.new(0, 8)
		nc.Parent = NotifBox

		local nStroke = Instance.new("UIStroke")
		nStroke.Color = Color3.fromRGB(180, 0, 0)
		nStroke.Thickness = 1.5
		nStroke.Parent = NotifBox

		local NTitle = Instance.new("TextLabel")
		NTitle.Size = UDim2.new(1, -16, 0, 20)
		NTitle.Position = UDim2.new(0, 10, 0, 6)
		NTitle.BackgroundTransparency = 1
		NTitle.Font = Enum.Font.GothamBold
		NTitle.Text = title
		NTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		NTitle.TextSize = 12
		NTitle.TextXAlignment = Enum.TextXAlignment.Left
		NTitle.ZIndex = 21
		NTitle.Parent = NotifBox

		local NDesc = Instance.new("TextLabel")
		NDesc.Size = UDim2.new(1, -16, 0, 26)
		NDesc.Position = UDim2.new(0, 10, 0, 26)
		NDesc.BackgroundTransparency = 1
		NDesc.Font = Enum.Font.Gotham
		NDesc.Text = message
		NDesc.TextColor3 = Color3.fromRGB(170, 170, 180)
		NDesc.TextSize = 10
		NDesc.TextWrapped = true
		NDesc.TextXAlignment = Enum.TextXAlignment.Left
		NDesc.ZIndex = 21
		NDesc.Parent = NotifBox

		-- أنميشن الدخول
		TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

		task.delay(duration, function()
			local outTween = TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 50, 0, 0)})
			outTween:Play()
			outTween.Completed:Connect(function()
				NotifBox:Destroy()
			end)
		end)
	end

	-- 2. زر الفتح والإغلاق العائم (Open/Close Button System) مع دعم السحب والتخصيص
	if OpenButtonEnabled then
		local OpenBtn = Instance.new("TextButton")
		OpenBtn.Name = "OpenButton"
		OpenBtn.Size = UDim2.new(0, 45, 0, 45)
		OpenBtn.Position = UDim2.new(0, 20, 0.5, -22)
		OpenBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
		OpenBtn.BorderSizePixel = 0
		OpenBtn.AutoButtonColor = false
		OpenBtn.Font = Enum.Font.GothamBold
		OpenBtn.Text = "⚡"
		OpenBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
		OpenBtn.TextSize = 20
		OpenBtn.Active = true
		OpenBtn.ZIndex = 30
		OpenBtn.Parent = ScreenGui

		local obc = Instance.new("UICorner")
		obc.CornerRadius = UDim.new(1, 0)
		obc.Parent = OpenBtn

		local obs = Instance.new("UIStroke")
		obs.Color = Color3.fromRGB(180, 0, 0)
		obs.Thickness = 2
		obs.Parent = OpenBtn

		-- إمكانية سحب الزر العائم بسلاسة
		local openDragging = false
		local openDragStart, openStartPos
		OpenBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				openDragging = true
				openDragStart = input.Position
				openStartPos = OpenBtn.Position
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if openDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - openDragStart
				OpenBtn.Position = UDim2.new(openStartPos.X.Scale, openStartPos.X.Offset + delta.X, openStartPos.Y.Scale, openStartPos.Y.Offset + delta.Y)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				openDragging = false
			end
		end)

		OpenBtn.MouseButton1Click:Connect(function()
			MainFrame.Visible = not MainFrame.Visible
		end)
	end

	return TabsAPI, UI_Library
end

return UI_Library
